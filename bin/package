#!/usr/bin/env ruby
require "rubygems/package"
require "tmpdir"
require "rbconfig"
require "bundler"

root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  abort "gem build failed" unless system(RbConfig.ruby, "-S", "gem", "build", "five_pm.gemspec", "--strict")
  require_relative "../lib/five_pm/version"
  path = "five_pm-#{FivePM::VERSION}.gem"
  package = Gem::Package.new(path)
  expected = Gem::Specification.load("five_pm.gemspec")
  unless package.spec.name == expected.name && package.spec.version == expected.version
    abort "package metadata mismatch"
  end
  abort "package file mismatch" unless package.spec.files.sort == expected.files.sort
  abort "license mismatch" unless package.spec.license == "MIT" && package.spec.files.include?("LICENSE")
  if package.spec.files.any? { |file| file.match?(%r{(^|/)(spec|vendor|coverage|\.env)(/|$)}) }
    abort "unexpected private or development files in package"
  end
  Dir.mktmpdir("five-pm-package-") do |directory|
    package.extract_files(directory)
    smoke = <<~CODE
      require "five_pm"
      model = FivePM::Models::Task.new({"id" => "42", "hidden" => "false", "future" => true})
      abort "mapping failed" unless model.id == 42 && model.hidden == false && model.raw["future"] == true
      abort "wrong load path" unless $LOADED_FEATURES.any? { |path| path.end_with?("/five_pm.rb") && File.realpath(path).start_with?(File.realpath(ARGV.fetch(0)) + File::SEPARATOR) }
    CODE
    dependency_path = Bundler.load.specs.map(&:base_dir).uniq.join(File::PATH_SEPARATOR)
    Bundler.with_unbundled_env do
      valid = system({ "GEM_PATH" => dependency_path }, RbConfig.ruby, "-I#{directory}/lib", "-e", smoke, directory)
      abort "isolated package smoke test failed" unless valid
    end
  end
  puts "Verified #{path}"
end
