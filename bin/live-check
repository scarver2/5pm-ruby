#!/usr/bin/env ruby
# Opt-in live integration checks. Never run in CI; never publishes packages.
require "json"
require "open3"
require "timeout"
require "digest"
require_relative "../lib/five_pm/version"

abort "usage: ruby bin/live-check [--mutations]" unless [[], ["--mutations"]].include?(ARGV)
unless ENV["FIVE_PM_SANDBOX"] == "1" && ENV.fetch("FIVE_PM_HOST", "") != "" &&
       ENV["FIVE_PM_SANDBOX_HOST"] == ENV["FIVE_PM_HOST"]
  abort "designate a disposable tenant with FIVE_PM_SANDBOX=1 and matching FIVE_PM_SANDBOX_HOST"
end
mutations = ARGV == ["--mutations"]
if mutations && ENV["FIVE_PM_ALLOW_MUTATIONS"] != "1"
  abort "set FIVE_PM_ALLOW_MUTATIONS=1 for disposable mutation checks"
end
root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  scripts = ["live_reads"]
  scripts += %w[live_mutations live_attachments_users live_cleanup] if mutations
  reports = scripts.map do |script|
    stdout, stderr, status = Timeout.timeout(300) do
      Open3.capture3(RbConfig.ruby, "-Ilib", "-Imcp/lib", "spec/support/#{script}.rb")
    end
    result = JSON.parse(stdout) unless stdout.empty?
    diagnostics = stderr.lines.filter_map do |line|
      JSON.parse(line)
    rescue JSON::ParserError
      { "result" => "failed", "stage" => "local_harness" }
    end
    { check: script, passed: status.success? && result&.fetch("result") == "passed" && diagnostics.empty?,
      report: result, diagnostics: diagnostics }
  rescue JSON::ParserError, Timeout::Error
    { check: script, passed: false, diagnostics: [{ result: "failed", stage: "local_harness" }] }
  end
  files, status = Open3.capture2("git", "ls-files", "-co", "--exclude-standard", "-z")
  abort "could not identify source files" unless status.success?
  digest = Digest::SHA256.new
  files.split("\0").sort.each do |path|
    next if path == "docs/live-validation-report.json" || !File.file?(path)

    bytes = File.binread(path)
    digest.update("#{path}\0#{bytes.bytesize}\0").update(bytes)
  end
  commit, status = Open3.capture2("git", "rev-parse", "HEAD")
  abort "could not identify base commit" unless status.success?
  dirty, = Open3.capture2("git", "status", "--porcelain")
  passed = reports.all? { |report| report.fetch(:passed) }
  puts JSON.pretty_generate(result: passed ? "passed" : "failed", version: FivePM::VERSION,
                            checked_at: Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
                            evidence_commit: commit.strip, worktree_dirty: !dirty.empty?,
                            source_sha256: digest.hexdigest,
                            disposable_tenant: true, mutations_enabled: mutations, release_evidence: false,
                            reports: reports)
  exit(passed ? 0 : 1)
end
