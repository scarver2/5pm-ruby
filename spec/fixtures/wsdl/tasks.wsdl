<?xml version="1.0" encoding="UTF-8"?>
<definitions name="tasks"
    targetNamespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"
        xmlns="http://schemas.xmlsoap.org/wsdl/"
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
        xmlns:xsdmy="http://demo.5pmweb.com/api/v2/wsdl/schema.xsd"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:tns="http://demo.5pmweb.com/api/v2/wsdl/tasks"
        xmlns:nsc="http://demo.5pmweb.com/api/v2/wsdl/schema"
        xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
        xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/">
    <types>
        <xsd:schema targetNamespace="http://demo.5pmweb.com/api/v2/wsdl/tasks" xmlns:tns="http://demo.5pmweb.com/api/v2/wsdl/schema">
            <xsd:import schemaLocation="schema.xsd?2016-10-6" namespace="http://demo.5pmweb.com/api/v2/wsdl/schema"/>
        </xsd:schema>
    </types>
    <!-- header message -->
    <message name="header">
        <part name="sessionId" element="nsc:sessionId" />
    </message>

    <!-- Soap operations request/response messages -->
    <message name="addSoapRequest">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="addSoapResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateSoapRequest">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateSoapResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="removeSoapRequest">
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="removeSoapResponse">
        <part name="status" type="xsd:boolean"/>
    </message>
    <message name="getByIdSoapRequest">
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="getByIdSoapResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="getListSoapRequest">
        <part name="filter" type="nsc:TaskListFilter"/>
        <part name="offset" type="xsd:integer"/>
        <part name="count" type="xsd:integer"/>
        <part name="loadTeam" type="xsd:boolean"/>
    </message>
    <message name="getListSoapResponse">
        <part name="list" type="nsc:TaskList"/>
    </message>

    <!-- HttpGet operations request/response messages -->
    <message name="addHttpGetRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="addHttpGetResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateHttpGetRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateHttpGetResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="removeHttpGetRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="removeHttpGetResponse">
        <part name="status" type="xsd:boolean"/>
    </message>
    <message name="getByIdHttpGetRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="getByIdHttpGetResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="getListHttpGetRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="filter" type="nsc:TaskListFilter"/>
        <part name="offset" type="xsd:integer"/>
        <part name="count" type="xsd:integer"/>
        <part name="loadTeam" type="xsd:boolean"/>
    </message>
    <message name="getListHttpGetResponse">
        <part name="list" type="nsc:TaskList"/>
    </message>

    <!-- HttpPost operations request/response messages -->
    <message name="addHttpPostRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="addHttpPostResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateHttpPostRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="updateHttpPostResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="removeHttpPostRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="removeHttpPostResponse">
        <part name="status" type="xsd:boolean"/>
    </message>
    <message name="getByIdHttpPostRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="id" type="xsd:integer"/>
    </message>
    <message name="getByIdHttpPostResponse">
        <part name="task" type="nsc:Task"/>
    </message>
    <message name="getListHttpPostRequest">
        <part name="sessionId" type="xsd:string"/>
        <part name="filter" type="nsc:TaskListFilter"/>
        <part name="offset" type="xsd:integer"/>
        <part name="count" type="xsd:integer"/>
        <part name="loadTeam" type="xsd:boolean"/>
    </message>
    <message name="getListHttpPostResponse">
        <part name="list" type="nsc:TaskList"/>
    </message>


    <!-- Soap port type -->
    <portType name="TasksSoapPortType">
        <operation name="add">
            <input name="addSoapInput" message="tns:addSoapRequest"/>
            <output name="addSoapOutput" message="tns:addSoapResponse"/>
        </operation>
        <operation name="update">
            <input name="updateSoapInput" message="tns:updateSoapRequest"/>
            <output name="updateSoapOutput" message="tns:updateSoapResponse"/>
        </operation>
        <operation name="remove">
            <input name="removeSoapInput" message="tns:removeSoapRequest"/>
            <output name="removeSoapOutput" message="tns:removeSoapResponse"/>
        </operation>
        <operation name="getById">
            <input name="getByIdSoapInput" message="tns:getByIdSoapRequest"/>
            <output name="getByIdSoapOutput" message="tns:getByIdSoapResponse"/>
        </operation>
        <operation name="getList">
            <input name="getListSoapInput" message="tns:getListSoapRequest"/>
            <output name="getListSoapOutput" message="tns:getListSoapResponse"/>
        </operation>
    </portType>

    <!-- HttpGet port type -->
    <portType name="TasksHttpGetPortType">
        <operation name="add">
            <input name="addHttpGetInput" message="tns:addHttpGetRequest"/>
            <output name="addHttpGetOutput" message="tns:addHttpGetResponse"/>
        </operation>
        <operation name="update">
            <input name="updateHttpGetInput" message="tns:updateHttpGetRequest"/>
            <output name="updateHttpGetOutput" message="tns:updateHttpGetResponse"/>
        </operation>
        <operation name="remove">
            <input name="removeHttpGetInput" message="tns:removeHttpGetRequest"/>
            <output name="removeHttpGetOutput" message="tns:removeHttpGetResponse"/>
        </operation>
        <operation name="getById">
            <input name="getByIdHttpGetInput" message="tns:getByIdHttpGetRequest"/>
            <output name="getByIdHttpGetOutput" message="tns:getByIdHttpGetResponse"/>
        </operation>
        <operation name="getList">
            <input name="getListHttpGetInput" message="tns:getListHttpGetRequest"/>
            <output name="getListHttpGetOutput" message="tns:getListHttpGetResponse"/>
        </operation>
    </portType>

    <!-- HttpPost port type -->
    <portType name="TasksHttpPostPortType">
        <operation name="add">
            <input name="addHttpPostInput" message="tns:addHttpPostRequest"/>
            <output name="addHttpPostOutput" message="tns:addHttpPostResponse"/>
        </operation>
        <operation name="update">
            <input name="updateHttpPostInput" message="tns:updateHttpPostRequest"/>
            <output name="updateHttpPostOutput" message="tns:updateHttpPostResponse"/>
        </operation>
        <operation name="remove">
            <input name="removeHttpPostInput" message="tns:removeHttpPostRequest"/>
            <output name="removeHttpPostOutput" message="tns:removeHttpPostResponse"/>
        </operation>
        <operation name="getById">
            <input name="getByIdHttpPostInput" message="tns:getByIdHttpPostRequest"/>
            <output name="getByIdHttpPostOutput" message="tns:getByIdHttpPostResponse"/>
        </operation>
        <operation name="getList">
            <input name="getListHttpPostInput" message="tns:getListHttpPostRequest"/>
            <output name="getListHttpPostOutput" message="tns:getListHttpPostResponse"/>
        </operation>
    </portType>

    
    <!-- Soap port type binding -->
    <binding name="TasksSoapPortTypeBinding" type="tns:TasksSoapPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="add">
            <soap:operation soapAction="http://demo.5pmweb.com/api/v2/service/soap/tasks/add"/>
            <input name="addSoapInput">
                <soap:header message="tns:header" part="sessionId" use="literal"/>
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
            </input>
            <output name="addSoapOutput">
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
			</output>
        </operation>
        <operation name="update">
            <soap:operation soapAction="http://demo.5pmweb.com/api/v2/service/soap/tasks/update"/>
            <input name="updateSoapInput">
                <soap:header message="tns:header" part="sessionId" use="literal"/>
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
            </input>
            <output name="updateSoapOutput">
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
			</output>
        </operation>
        <operation name="remove">
            <soap:operation soapAction="http://demo.5pmweb.com/api/v2/service/soap/tasks/remove"/>
            <input name="removeSoapInput">
                <soap:header message="tns:header" part="sessionId" use="literal"/>
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
            </input>
            <output name="removeSoapOutput">
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
			</output>
        </operation>
        <operation name="getById">
            <soap:operation soapAction="http://demo.5pmweb.com/api/v2/service/soap/tasks/getById"/>
            <input name="getByIdSoapInput">
                <soap:header message="tns:header" part="sessionId" use="literal"/>
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
            </input>
            <output name="getByIdSoapOutput">
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
			</output>
        </operation>
        <operation name="getList">
            <soap:operation soapAction="http://demo.5pmweb.com/api/v2/service/soap/tasks/getList"/>
            <input name="getListSoapInput">
                <soap:header message="tns:header" part="sessionId" use="literal"/>
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
            </input>
            <output name="getListSoapOutput">
                <soap:body use="literal" namespace="http://demo.5pmweb.com/api/v2/wsdl/tasks"/>
			</output>
        </operation>
    </binding>

    <!-- HttpGet port type binding -->
    <binding name="TasksHttpGetPortTypeBinding" type="tns:TasksHttpGetPortType">
        <http:binding verb="GET"/>
        <operation name="add">
            <http:operation location="/add" />
            <input name="addHttpGetInput">
                <http:urlEncoded />
            </input>
            <output name="addHttpGetOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="update">
            <http:operation location="/update" />
            <input name="updateHttpGetInput">
                <http:urlEncoded />
            </input>
            <output name="updateHttpGetOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="remove">
            <http:operation location="/remove" />
            <input name="removeHttpGetInput">
                <http:urlEncoded />
            </input>
            <output name="removeHttpGetOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="getById">
            <http:operation location="/getById" />
            <input name="getByIdHttpGetInput">
                <http:urlEncoded />
            </input>
            <output name="getByIdHttpGetOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="getList">
            <http:operation location="/getList" />
            <input name="getListHttpGetInput">
                <http:urlEncoded />
            </input>
            <output name="getListHttpGetOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
    </binding>

    <!-- HttpPost port type binding -->
    <binding name="TasksHttpPostPortTypeBinding" type="tns:TasksHttpPostPortType">
        <http:binding verb="POST"/>
        <operation name="add">
            <http:operation location="/add" />
            <input name="addHttpPostInput">
                <http:urlEncoded />
            </input>
            <output name="addHttpPostOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="update">
            <http:operation location="/update" />
            <input name="updateHttpPostInput">
                <http:urlEncoded />
            </input>
            <output name="updateHttpPostOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="remove">
            <http:operation location="/remove" />
            <input name="removeHttpPostInput">
                <http:urlEncoded />
            </input>
            <output name="removeHttpPostOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="getById">
            <http:operation location="/getById" />
            <input name="getByIdHttpPostInput">
                <http:urlEncoded />
            </input>
            <output name="getByIdHttpPostOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
        <operation name="getList">
            <http:operation location="/getList" />
            <input name="getListHttpPostInput">
                <http:urlEncoded />
            </input>
            <output name="getListHttpPostOutput">
                <mime:mimeXml part="response" />
            </output>
        </operation>
    </binding>


    <!-- tasks management service -->
    <service name="TasksService">
        <documentation>5pm tasks servcie</documentation>
        <port name="TasksSoapPort" binding="tns:TasksSoapPortTypeBinding">
            <soap:address location="https://demo.5pmweb.com/api/v2/service/soap/tasks"/>
        </port>
        <port name="TasksHttpGetPort" binding="tns:TasksHttpGetPortTypeBinding">
            <http:address location="https://demo.5pmweb.com/api/v2/service/get/tasks" />
        </port>
        <port name="TasksHttpPostPort" binding="tns:TasksHttpPostPortTypeBinding">
            <http:address location="https://demo.5pmweb.com/api/v2/service/post/tasks" />
        </port>
    </service>
</definitions>